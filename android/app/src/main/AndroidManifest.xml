<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Permissions for SMS -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false"
        tools:targetApi="5" />

    <uses-permission android:name="android.permission.SEND_SMS"/>
    <uses-permission android:name="android.permission.RECEIVE_SMS"/>
    <uses-permission android:name="android.permission.READ_SMS"/>
    <!-- Required to qualify for the default-SMS-app role (ROLE_SMS) -->
    <uses-permission android:name="android.permission.RECEIVE_MMS"/>
    <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH"/>
    
    <!-- Permissions for Phone Calls -->
    <uses-permission android:name="android.permission.CALL_PHONE"/>
    <uses-permission android:name="android.permission.READ_PHONE_STATE"/>
    <uses-permission android:name="android.permission.READ_CALL_LOG"/>
    <uses-permission android:name="android.permission.WRITE_CALL_LOG"/>
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.PROCESS_OUTGOING_CALLS"/>
    <!-- Dual SIM: the *own* number of each SIM, shown under the SIM name in the
         picker the way Google Messages/Phone do. From Android 13 it is no
         longer covered by READ_PHONE_STATE. Purely cosmetic — a refusal leaves
         the carrier name in its place, it never blocks sending or calling. -->
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS"/>


    <!-- Permissions for Contacts -->
    <uses-permission android:name="android.permission.READ_CONTACTS"/>
    <uses-permission android:name="android.permission.WRITE_CONTACTS"/>
    
    <!-- Link previews in messages (og: metadata + preview images) -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Permissions for Notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Incoming-call notification must be able to launch the in-call UI -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <!-- PROXIMITY_SCREEN_OFF_WAKE_LOCK: blanks the screen while the phone is
         at the ear during a call. The default dialer owns the in-call UI, so
         the system does not do this for us — without it the cheek presses
         «بی‌صدا»/«پایان». See ProximityGate. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <!-- «موقعیت» in the composer's attachment sheet: the user's coordinates
         are read once, on that tap only, and inserted into the message as
         text. Nothing is tracked and nothing is sent anywhere else. COARSE is
         listed so a user who grants only the approximate location still gets a
         usable answer. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <!-- Exact alarms for background scheduled-SMS delivery (زمان‌بندی ارسال).
         USE_EXACT_ALARM is auto-granted on Android 13+; SCHEDULE_EXACT_ALARM
         covers 12 (the scheduler falls back to an inexact alarm if denied). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>

    <!-- Backup is OFF on purpose. `databases/communication_app.db` holds every
         SMS in plain text, and the app's PIN lock does not protect a copy that
         has left the device: Auto Backup (cloud) and `adb backup` would both
         lift the whole mailbox. The secure-storage key stays in the Keystore
         and is never backed up, so a restore could not even unlock the app it
         handed the messages to.
         `dataExtractionRules` covers the Android 12+ transfer paths
         (cloud backup + device-to-device), `fullBackupContent` the ≤11 ones. -->
    <application
        android:label="هم‌رسان"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Default-SMS-app role requirement: handle sms:/smsto:/mms:/mmsto:
                 send intents (e.g. tapping a number in the browser). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <action android:name="android.intent.action.SENDTO"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="sms"/>
                <data android:scheme="smsto"/>
                <data android:scheme="mms"/>
                <data android:scheme="mmsto"/>
            </intent-filter>
            <!-- Default-dialer role requirement: handle ACTION_DIAL, both with
                 a tel: number and bare (open the keypad). -->
            <intent-filter>
                <action android:name="android.intent.action.DIAL"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="tel"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="tel"/>
            </intent-filter>
        </activity>
        
        <!-- CallConnectionService برای TelecomManager -->
        <service
            android:name=".call.CallConnectionService"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.ConnectionService" />
            </intent-filter>
        </service>

        <!-- Default-dialer role: telecom binds this while the app holds
             ROLE_DIALER, making it the ONLY in-call UI on the device.
             IN_CALL_SERVICE_RINGING=false → telecom keeps playing the
             ringtone; this app only renders the UI. -->
        <service
            android:name=".call.CallInCallService"
            android:permission="android.permission.BIND_INCALL_SERVICE"
            android:exported="true">
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true"/>
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_RINGING"
                android:value="false"/>
            <intent-filter>
                <action android:name="android.telecom.InCallService"/>
            </intent-filter>
        </service>

        <!-- Answer/decline actions on the incoming-call notification -->
        <receiver
            android:name=".call.CallActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.communication_super_app.ANSWER_CALL"/>
                <action android:name="com.example.communication_super_app.DECLINE_CALL"/>
                <!-- «تماس» on a missed-call notification -->
                <action android:name="com.example.communication_super_app.CALL_BACK"/>
            </intent-filter>
        </receiver>

        <!-- Inline-reply / mark-read actions on the cold-start SMS notification -->
        <receiver
            android:name=".SmsNotificationActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.communication_super_app.SMS_REPLY"/>
                <action android:name="com.example.communication_super_app.SMS_MARK_READ"/>
            </intent-filter>
        </receiver>

        <!-- Background SMS delivery: when the app process is dead, this
             manifest receiver persists the message + posts a notification
             natively. When the app is alive, SmsHandler's dynamic receiver +
             Flutter handle it and this receiver bails out (see
             SmsHandler.isDynamicReceiverActive). BROADCAST_SMS restricts the
             sender to the system. (Replaces the old hardcoded
             com.shounakmulay.telephony receiver, whose class no longer exists
             after the another_telephony swap.) -->
        <receiver
            android:name=".IncomingSmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED"/>
            </intent-filter>
        </receiver>

        <!-- Default-SMS-app role: SMS_DELIVER is sent ONLY to the default app.
             This receiver writes the incoming message into content://sms —
             the system stops doing that once we hold the role. App-side
             persist/notify keeps flowing through SMS_RECEIVED as before. -->
        <receiver
            android:name=".SmsDeliverReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER"/>
            </intent-filter>
        </receiver>

        <!-- Default-SMS-app role requirement: MMS delivery (stub — MMS dropped). -->
        <receiver
            android:name=".MmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER"/>
                <data android:mimeType="application/vnd.wap.mms-message"/>
            </intent-filter>
        </receiver>

        <!-- Default-SMS-app role requirement: reject-call-with-message. -->
        <service
            android:name=".HeadlessSmsSendService"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="sms"/>
                <data android:scheme="smsto"/>
                <data android:scheme="mms"/>
                <data android:scheme="mmsto"/>
            </intent-filter>
        </service>

        <!-- Scheduled-SMS background delivery (زمان‌بندی ارسال, PHASE 2) -->
        <receiver
            android:name=".scheduled.ScheduledSmsAlarmReceiver"
            android:exported="false"/>
        <receiver
            android:name=".scheduled.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            </intent-filter>
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- url_launcher: resolve browsers for links tapped inside messages -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="http"/>
        </intent>
        <!-- «برنامه‌های متصل» on a contact: the rows a messenger writes onto a
             contact belong to its sync account. Without these two entries the
             package-visibility filter (targetSdk 30+) hides the authenticator
             from AccountManager.getAuthenticatorTypes() and makes
             PackageManager.getApplicationInfo() throw, so every third-party row
             would be dropped and the section would render empty. -->
        <intent>
            <action android:name="android.accounts.AccountAuthenticator"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:mimeType="vnd.android.cursor.item/*"/>
        </intent>
    </queries>
</manifest>
